# ── BlockBite — Environment Variables Template ────────────────────────────────
# Copy this file to .env.local (never commit the real .env.local)
# Set these in Vercel → Project → Settings → Environment Variables
#
# Network, program ID and USDC mint are fixed to Solana mainnet in
# lib/solana/config.ts and cannot be changed through env vars.

NEXT_PUBLIC_APP_URL=https://blockbite.vercel.app

# ── RPC endpoint (optional; defaults to the public mainnet endpoint) ──────────
# Use a private mainnet RPC in production. Devnet/testnet URLs are ignored.
# NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ── Prize-pool stream (required before tickets can be sold) ───────────────────
# Address of the blockbite-vesting stream account whose vault holds the prize
# pool. Ticket purchases call FundVault on it. Until set, the shop refuses sales.

# ── Session token secret ──────────────────────────────────────────────────────
# HMAC-SHA256 secret for signing game session tokens. openssl rand -hex 32
SESSION_SECRET=
# Ranked: HMAC key for daily seeds and sign-in sessions (32 random bytes, hex). Never share.
RANKED_SECRET=

# ── Vercel KV ─────────────────────────────────────────────────────────────────
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# ── Waitlist admin token ──────────────────────────────────────────────────────
# Protects /api/waitlist/list and /waitlist/dashboard. openssl rand -hex 24
ADMIN_TOKEN=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
